# Copy this file to  .env  and fill in real values there.
# .env is gitignored; .env.example is committed — never put real secrets here.

# ── Agent runtime ─────────────────────────────────────────────────────────────
# strands = run triage / investigator / doer / educator as strands.Agent
#           (auto-falls back to the direct path per-agent on any SDK error)
# direct  = skip Strands entirely
AGENT_RUNTIME=strands

# ── LLM provider ────────────────────────────────────────────────────────────────
# groq (free) | openai | azure
LLM_PROVIDER=groq

# Groq — free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_SMART_MODEL=openai/gpt-oss-120b

# --- OpenAI (only if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# LLM_FAST_MODEL=gpt-4o-mini
# LLM_SMART_MODEL=gpt-4o

# --- Azure OpenAI (only if LLM_PROVIDER=azure; values are DEPLOYMENT names) ---
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# LLM_FAST_MODEL=gpt-4o-mini
# LLM_SMART_MODEL=gpt-4o

# ── Embeddings ─────────────────────────────────────────────────────────────────
# fastembed = local model, no API key (downloads ~90MB once). Groq has no embeddings API.
# Alternatives: openai (needs OPENAI_API_KEY) | jina (needs JINA_API_KEY, free at jina.ai)
EMBED_PROVIDER=fastembed
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBED_DIM=384
# JINA_API_KEY=jina_...

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Twilio (optional — WhatsApp sends are skipped if blank) ────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Group members (hardcoded for demo; include +91 for India) ─────────────────
MOTHER_PHONE=whatsapp:+919876543210
NATU_PHONE=whatsapp:+919876543211

# ── Investigator agent ────────────────────────────────────────────────────────
INVESTIGATOR_MODE=agentic
INVESTIGATOR_MAX_STEPS=6
INVESTIGATOR_EARLY_STOP_SCORE=70

# ── Reputation / immunity / educator ─────────────────────────────────────────
REPUTATION_REPEAT_OFFENDER_THRESHOLD=2
IMMUNITY_CANONICAL_THRESHOLD=0.84
EDUCATION_NOTES_ENABLED=true

# ── Ingress / security ───────────────────────────────────────────────────────────
# The SMS forwarder must send this as header  X-Kavach-Token: <value>
# Leave blank for local dev; MUST be set when APP_ENV=production.
INGEST_SECRET=
# Validate Twilio's X-Twilio-Signature on /whatsapp (turn on once deployed on HTTPS)
TWILIO_VALIDATE_SIGNATURE=false
DEDUP_WINDOW_SECONDS=600

# ── Pipeline hosting ─────────────────────────────────────────────────────────────
# local = run the pipeline in-process | agentcore = invoke the Bedrock AgentCore runtime
PIPELINE_MODE=local
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:...:runtime/kavach-xxxx
AGENTCORE_REGION=us-west-2

# ── App ──────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email intake (IMAP poll — no OAuth, no phone) ────────────────────────────────
# Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords  and paste it below (no spaces).
EMAIL_INTAKE_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_POLL_SECONDS=120
